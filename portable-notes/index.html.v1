<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Portable Notes</title><style>
:root{font-family:system-ui,Segoe UI,sans-serif;color:#243044;background:#f3f5f9}*{box-sizing:border-box}body{margin:0}header{background:#1e3553;color:white;padding:12px 18px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}header h1{font-size:19px;margin:0 auto 0 0}button,.file-button{border:1px solid #bcc8d6;background:white;color:#26374d;border-radius:6px;padding:8px 11px;cursor:pointer;font:inherit;font-size:13px}button:hover,.file-button:hover{background:#e9f1fa}button.primary{background:#2174be;color:white;border-color:#2174be}button.danger{color:#a12525}button:disabled{opacity:.5;cursor:not-allowed}.file-button input{display:none}.layout{display:grid;grid-template-columns:310px 1fr;height:calc(100vh - 65px)}aside{background:white;border-right:1px solid #dbe2ea;display:flex;flex-direction:column;min-height:0}.sidebar-actions{padding:12px;display:flex;flex-wrap:wrap;gap:6px;border-bottom:1px solid #e0e5ec}#search{width:100%;padding:9px;border:1px solid #ccd4de;border-radius:6px}.tree{overflow:auto;padding:10px;flex:1}.tree-row{display:flex;align-items:center;gap:3px;min-height:31px;border-radius:5px}.tree-row.selected{background:#dcecfb}.tree-row button{border:0;background:transparent;padding:4px;width:23px;flex-shrink:0}.tree-row .name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;text-align:left;width:auto;padding:6px}.tree-row .name:hover{background:#eef3f9}main{padding:20px;overflow:auto;min-width:0}.editor{max-width:1100px;margin:auto}.meta{font-size:12px;color:#667487;margin:10px 0}.title-input{width:100%;padding:12px;font-size:21px;font-weight:600;border:1px solid #cbd4df;border-radius:6px}.toolbar{display:flex;gap:5px;flex-wrap:wrap;background:#e9eef5;padding:7px;margin-top:12px;border:1px solid #cbd4df;border-bottom:0;border-radius:6px 6px 0 0}.toolbar button{padding:5px 9px;min-width:31px}.content{background:white;border:1px solid #cbd4df;min-height:50vh;padding:16px;outline:none;line-height:1.55;overflow-wrap:anywhere;border-radius:0 0 6px 6px}.content:focus{border-color:#2174be}.editor-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.hint{font-size:12px;color:#67788b}.status{font-size:12px;color:#e7f5ff}.empty{padding:24px;color:#667487}.search-hit{font-size:11px;color:#64748b}.hidden{display:none!important}@media(max-width:700px){.layout{grid-template-columns:1fr;height:auto}aside{height:35vh;border-right:0;border-bottom:1px solid #dbe2ea}main{padding:12px}.content{min-height:35vh}}
</style></head><body><header><h1>🗂 Portable Notes</h1><button id="openBtn">Open JSON</button><button id="saveBtn" class="primary">Save JSON</button><button id="enableAuto" class="hidden">Enable autosave</button><button id="saveAsBtn">Save As / Download</button><span id="status" class="status">Not saved</span><input type="file" id="fileInput" accept=".json,application/json" hidden></header><div class="layout"><aside><div class="sidebar-actions"><input id="search" placeholder="Search titles and note text…"><button id="newRoot">+ New note</button><button id="expandAll">Expand all</button><button id="collapseAll">Collapse all</button></div><div id="tree" class="tree"></div></aside><main><div id="empty" class="empty">Create a note or open an existing JSON file.</div><div id="editor" class="editor hidden"><input id="noteTitle" class="title-input" placeholder="Note title"><div id="meta" class="meta"></div><div class="toolbar" id="toolbar"><button data-cmd="bold" title="Bold"><b>B</b></button><button data-cmd="italic" title="Italic"><i>I</i></button><button data-cmd="underline" title="Underline"><u>U</u></button><button data-cmd="insertUnorderedList" title="Bulleted list">• List</button><button data-cmd="insertOrderedList" title="Numbered list">1. List</button><button data-cmd="formatBlock" data-value="h2" title="Heading">H2</button><button data-cmd="formatBlock" data-value="p" title="Paragraph">¶</button><button id="linkBtn" title="Add link">Link</button><button data-cmd="removeFormat">Clear style</button></div><div id="noteContent" class="content" contenteditable="true" spellcheck="true"></div><div class="editor-actions"><button id="newChild">+ Child note</button><button id="moveNote">Move to parent…</button><button id="deleteNote" class="danger">Delete note + descendants</button></div><p class="hint">After selecting a writable JSON file, edits autosave after 1 second. If autosave is paused, click Enable autosave. Keep separate backup copies of important data.</p></div></main></div><script>
(()=>{'use strict';const $=id=>document.getElementById(id);const TZ='America/New_York';let notes=[],selected=null,collapsed=new Set(),dirty=false,handle=null,fileName='notes.json',debounce,autosaveTimer,writeChain=Promise.resolve(),revision=0,savedRevision=0,permissionWarned=false;const now=()=>new Date().toISOString(),uid=()=>globalThis.crypto?.randomUUID?.()||'n-'+Date.now()+'-'+Math.random().toString(36).slice(2);const escapeHTML=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const date=s=>{if(!s)return '—';let d=new Date(s);return isNaN(d)?String(s):new Intl.DateTimeFormat('en-US',{timeZone:TZ,dateStyle:'medium',timeStyle:'short'}).format(d)};const get=id=>notes.find(n=>n.id===id);function status(s){$('status').textContent=s}function mark(){dirty=true;revision++;status(handle?'Saving soon…':'Not linked — select JSON file to enable autosave');queueAutosave()}function queueAutosave(){clearTimeout(autosaveTimer);if(handle)autosaveTimer=setTimeout(()=>autoSave(),1100)}
async function autoSave(){flush();if(!handle||!dirty)return;const target=revision;const snapshot=JSON.stringify(notes,null,2);writeChain=writeChain.catch(()=>{}).then(async()=>{if(!handle)return;try{const permission=await handle.queryPermission({mode:'readwrite'});if(permission!=='granted'){status('Autosave paused — click Enable autosave');$('enableAuto').classList.remove('hidden');return}status('Saving…');const writable=await handle.createWritable();await writable.write(snapshot);await writable.close();savedRevision=Math.max(savedRevision,target);dirty=revision>savedRevision;status(dirty?'Saving newer edits…':'Autosaved '+fileName+' at '+new Date().toLocaleTimeString());if(dirty)queueAutosave()}catch(e){status('Autosave failed: '+e.message);$('enableAuto').classList.remove('hidden')}});await writeChain}
async function enableAutosave(){if(!handle){await openFile();return}try{let permission=await handle.queryPermission({mode:'readwrite'});if(permission!=='granted')permission=await handle.requestPermission({mode:'readwrite'});if(permission!=='granted'){status('Write permission denied — use Save JSON');return}$('enableAuto').classList.add('hidden');status('Autosave enabled for '+fileName);if(dirty)queueAutosave()}catch(e){status('Autosave unavailable: '+e.message)}}
function normalize(data){if(!Array.isArray(data)){if(Array.isArray(data.notes))data=data.notes;else throw Error('Expected a JSON array or an object with a notes array.')}let seen=new Set();return data.map((r,i)=>{let id=String(r.id??uid());if(seen.has(id))id=uid();seen.add(id);let text=String(r.text??r.content??'');let html=r.html!=null?String(r.html):null;return{id,name:String(r.name??r.title??'Untitled'),text,html,parent:r.parent==null||r.parent===''?null:String(r.parent),created:r.created??r.created_at??null,modified:r.modified??r.updated_at??null};});}function children(id){return notes.filter(n=>n.parent===id)}function roots(){let ids=new Set(notes.map(n=>n.id));return notes.filter(n=>!n.parent||!ids.has(n.parent)||n.parent===n.id)}function drawTree(){let q=$('search').value.trim().toLowerCase(),el=$('tree');el.replaceChildren();let shown=new Set(),stack=new Set();const matches=n=>(n.name+' '+(n.html?strip(n.html):n.text)).toLowerCase().includes(q);let visible=new Set();if(q){for(let n of notes)if(matches(n)){let cur=n;let chain=new Set();while(cur&&!chain.has(cur.id)){visible.add(cur.id);chain.add(cur.id);cur=get(cur.parent)}}}function walk(n,depth){if(shown.has(n.id)||stack.has(n.id)||q&&!visible.has(n.id))return;stack.add(n.id);shown.add(n.id);let kids=children(n.id).filter(x=>x.id!==n.id),row=document.createElement('div');row.className='tree-row'+(selected===n.id?' selected':'');row.style.paddingLeft=Math.min(depth,25)*14+'px';let toggle=document.createElement('button');toggle.textContent=kids.length?(collapsed.has(n.id)&&!q?'▸':'▾'):'·';toggle.title='Expand/collapse';toggle.onclick=()=>{if(collapsed.has(n.id))collapsed.delete(n.id);else collapsed.add(n.id);drawTree()};row.append(toggle);let b=document.createElement('button');b.className='name';b.textContent=n.name||'Untitled';b.title=n.name;b.onclick=()=>select(n.id);row.append(b);el.append(row);if(!collapsed.has(n.id)||q)for(let k of kids)walk(k,depth+1);stack.delete(n.id)}let rootNotes=roots();for(let n of rootNotes)walk(n,0);
// Track structural reachability independently of the expanded/collapsed UI state.
// A collapsed descendant is hidden intentionally, not an unlinked note.
let reachable=new Set(),pending=[...rootNotes];while(pending.length){let n=pending.pop();if(reachable.has(n.id))continue;reachable.add(n.id);for(let child of children(n.id))pending.push(child)}
for(let n of notes)if(!reachable.has(n.id)&&!shown.has(n.id)&&(!q||visible.has(n.id))){let row=document.createElement('div');row.className='search-hit';row.textContent='Unlinked / cyclic branch';el.append(row);walk(n,0)}if(!notes.length)el.textContent='No notes yet.'}function strip(h){let t=document.createElement('div');t.innerHTML=h;return t.textContent||''}function safeHtml(html){let doc=new DOMParser().parseFromString(html,'text/html');doc.querySelectorAll('script,style,iframe,object,embed,form,svg,math,meta,link').forEach(x=>x.remove());for(let el of [...doc.body.querySelectorAll('*')]){for(let a of [...el.attributes]){let name=a.name.toLowerCase(),val=a.value.trim();if(name.startsWith('on')||name==='style'||name==='src'||name==='srcdoc'||name==='formaction'||(name==='href'&&!/^(https?:|mailto:|#)/i.test(val)))el.removeAttribute(a.name)}}return doc.body.innerHTML}function select(id){flush();selected=id;let n=get(id);$('empty').classList.toggle('hidden',!!n);$('editor').classList.toggle('hidden',!n);if(n){$('noteTitle').value=n.name;$('noteContent').innerHTML=n.html!=null?safeHtml(n.html):escapeHTML(n.text).replace(/\r\n|\r|\n/g,'<br>');$('meta').textContent='Created: '+date(n.created)+'  |  Modified: '+date(n.modified)+'  (New York time)'}drawTree()}function flush(){if(!selected)return;let n=get(selected);if(!n)return;let name=$('noteTitle').value.trim()||'Untitled',html=$('noteContent').innerHTML,text=$('noteContent').innerText;if(n.name!==name||n.html!==html||n.text!==text){n.name=name;n.html=html;n.text=text;n.modified=now();mark()}}function schedule(){clearTimeout(debounce);debounce=setTimeout(()=>{flush();drawTree()},250)}function add(parent){flush();let n={id:uid(),name:'New note',text:'',html:'',parent,created:now(),modified:now()};notes.push(n);if(parent)collapsed.delete(parent);mark();select(n.id);$('noteTitle').focus();$('noteTitle').select()}function descendants(id){let result=new Set([id]),queue=[id];while(queue.length){let x=queue.shift();for(let n of notes)if(n.parent===x&&!result.has(n.id)){result.add(n.id);queue.push(n.id)}}return result}function download(){let blob=new Blob([JSON.stringify(notes,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=fileName;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);dirty=false;status('Downloaded '+fileName+' (keep this file safe)')}async function save(as=false){flush();if(!as&&handle){await enableAutosave();if(handle){clearTimeout(autosaveTimer);if(!dirty){status('Already saved '+fileName);return}await autoSave();return}}if('showSaveFilePicker' in window){try{let h=await window.showSaveFilePicker({suggestedName:fileName,types:[{description:'JSON notes',accept:{'application/json':['.json']}}]});handle=h;fileName=h.name;await enableAutosave();if(handle){dirty=true;revision++;await autoSave();return}}catch(e){if(e.name==='AbortError')return;status('File access unavailable: '+e.message)}}download()}
async function openFile(){if(dirty&&!confirm('You have unsaved changes. Open another file and discard them?'))return;if('showOpenFilePicker' in window){try{let [h]=await window.showOpenFilePicker({types:[{description:'JSON notes',accept:{'application/json':['.json']}}]});let f=await h.getFile();await load(await f.text(),f.name,h);return}catch(e){if(e.name==='AbortError')return;}}$('fileInput').click()}async function load(raw,name,h){try{let parsed=normalize(JSON.parse(raw));notes=parsed;fileName=name;handle=h||null;selected=null;collapsed.clear();dirty=false;revision=0;savedRevision=0;clearTimeout(autosaveTimer);$('search').value='';$('enableAuto').classList.toggle('hidden',!handle);status('Opened '+fileName+(handle?' — click Enable autosave':' — browser cannot write this file automatically'));select(notes[0]?.id||null)}catch(e){alert('Unable to open JSON: '+e.message)}}$('fileInput').onchange=async e=>{let f=e.target.files[0];if(f)await load(await f.text(),f.name,null);e.target.value=''};$('enableAuto').onclick=enableAutosave;$('openBtn').onclick=openFile;$('saveBtn').onclick=()=>save();$('saveAsBtn').onclick=()=>save(true);$('newRoot').onclick=()=>add(null);$('newChild').onclick=()=>selected&&add(selected);$('expandAll').onclick=()=>{collapsed.clear();drawTree()};$('collapseAll').onclick=()=>{collapsed=new Set(notes.map(n=>n.id));drawTree()};$('search').oninput=drawTree;$('noteTitle').oninput=schedule;$('noteContent').oninput=schedule;$('deleteNote').onclick=()=>{if(!selected)return;let ids=descendants(selected);if(!confirm('Delete this note and all '+(ids.size-1)+' descendant note(s)?'))return;notes=notes.filter(n=>!ids.has(n.id));selected=null;mark();select(notes[0]?.id||null)};$('moveNote').onclick=()=>{if(!selected)return;flush();let excluded=descendants(selected),options=notes.filter(n=>!excluded.has(n.id));let message='Enter a new parent note ID, or leave blank to make this a root note.\n\n'+options.slice(0,70).map(n=>n.id+' — '+n.name).join('\n');let p=prompt(message,get(selected).parent||'');if(p===null)return;p=p.trim();if(p&&!options.some(n=>n.id===p)){alert('Parent ID not found or would create a cycle.');return}get(selected).parent=p||null;mark();drawTree()};$('toolbar').addEventListener('mousedown',e=>{if(e.target.closest('button'))e.preventDefault()});$('toolbar').onclick=e=>{let b=e.target.closest('[data-cmd]');if(!b)return;$('noteContent').focus();document.execCommand(b.dataset.cmd,false,b.dataset.value||null);schedule()};$('linkBtn').onclick=()=>{let u=prompt('Enter an https:// or http:// link:','https://');if(!u)return;if(!/^https?:\/\//i.test(u)){alert('Only http(s) links are supported.');return}$('noteContent').focus();document.execCommand('createLink',false,u);schedule()};document.addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='s'){e.preventDefault();save()}});window.addEventListener('beforeunload',e=>{flush();if(dirty){e.preventDefault();e.returnValue=''}});select(null);
})();</script></body></html>
